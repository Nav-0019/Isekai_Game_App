<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="100sp"
    android:background="#1F1F1F"
    tools:context=".Status">



    <LinearLayout
        android:id="@+id/body"
        android:layout_width="339dp"
        android:layout_height="wrap_content"
        android:background="@drawable/status"
        android:orientation="vertical"
        android:padding="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:layout_marginBottom="10sp"
            android:textIsSelectable="false"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            />

        <!-- HP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HP"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_hp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- EP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EP"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_ep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- MP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MP"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_mp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- Strength -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Strength"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_strength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- Agility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Agility"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_agility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- Power -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Power"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- Equipment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Equipment"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/status_equip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Knife"
                android:textColor="@color/white"
                android:textSize="25sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backbtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#7803C8C8"
            android:text="Back"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20sp"
            />


    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>